# Copie para .env e preencha:  cp .env.example .env
#
# Usamos o SDK da OpenAI apontado para a API da Mistral (mesma pilha dos
# laboratórios da disciplina). O nome da variável é OPENAI_API_KEY porque é o
# nome que o SDK procura por padrão — o valor é a chave da Mistral.

# Crie a chave em https://admin.mistral.ai/ (menu API Keys -> Create new key).
OPENAI_API_KEY=

# Endpoint compatível com a API da OpenAI.
LLM_BASE_URL=https://api.mistral.ai/v1

# Modelo padrão do agente (justificativa em docs/modelos.md).
LLM_MODELO=mistral-small-latest
